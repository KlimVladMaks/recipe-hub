# Remote state в Yandex Object Storage.
#
# Конфигурация бэкенда намеренно частичная: конкретные значения (бакет, ключ
# доступа) передаются через `-backend-config=backend.hcl` (файл в .gitignore,
# создаётся `scripts/init-state.sh`) или через переменные окружения в CI.
#
# Это нужно, чтобы `terraform apply` можно было одинаково безопасно запускать
# и с ноутбука, и из GitHub Actions: состояние живёт в облаке, а не в раннере,
# поэтому `destroy` из следующего запуска видит то, что создал предыдущий.

terraform {
  backend "s3" {}
}
