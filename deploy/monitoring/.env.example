# Grafana: учётная запись администратора.
#
# В git хранится только этот шаблон. Роль app при деплое копирует его в
# deploy/monitoring/.env (copy с force: false — существующий файл на сервере
# не перезаписывается). Файл читает контейнер grafana через env_file,
# поэтому имена переменных — родные для Grafana (GF_*).
#
# Смените пароль на сервере и перезапустите Grafana:
#   cd /opt/recipe-hub
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml \
#                  -f deploy/docker-compose.monitoring.yml up -d grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-monitoring
