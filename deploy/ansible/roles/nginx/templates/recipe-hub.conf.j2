# Конфиг RecipeHub: nginx как обратный прокси к API-шлюзу.
#
# ШАБЛОН Ansible: построен из
# deploy/ansible/roles/nginx/templates/recipe-hub.conf.j2
# и раскладывается ролью nginx в /etc/nginx/sites-available/recipe-hub.
# Правки вносить в шаблон в репозитории, а не прямо на сервере —
# иначе они потеряются при следующем прогоне playbook-а.
#
# Переменные: nginx_server_name, nginx_gateway_upstream,
#             nginx_client_max_body_size (deploy/ansible/group_vars/all.yml).
#
# Схема: клиент -> nginx :80 -> api-gateway :3000 (127.0.0.1)
# Порт 3000 и внутренние порты (БД, RabbitMQ) на сервере привязаны к 127.0.0.1,
# поэтому наружу доступен только nginx.

server {
    listen 80;
    listen [::]:80;

    # `_` работает как "любой Host", т.е. и по IP, и по домену.
    # Когда появится домен — задай его в nginx_server_name.
    server_name {{ nginx_server_name }};

    access_log /var/log/nginx/recipe-hub.access.log;
    error_log  /var/log/nginx/recipe-hub.error.log;

    # Запрет на доступ к внутренним service-to-service маршрутам извне.
    # Внутри docker-сети сервисы общаются напрямую, а не через nginx,
    # поэтому блокировка снаружи безопасна.
    location /api/internal/ {
        return 403;
    }

    location / {
        proxy_pass http://{{ nginx_gateway_upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Поддержка WebSocket / upgrade-соединений (на будущее).
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # Максимальный размер загружаемого тела (фото рецептов и т.п.).
    client_max_body_size {{ nginx_client_max_body_size }};
}

